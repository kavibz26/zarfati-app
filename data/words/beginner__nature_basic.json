  "sentences": [
    {
      "id": "s000375",
      "es": "Hay un río cerca de mi pueblo.",
      "he": "יש נהר קרוב לכפר שלי."
    },
    {
      "id": "s000376",
      "es": "Vamos a caminar por el bosque.",
      "he": "אנחנו הולכים לטייל ביער."
    },
    {
      "id": "s000377",
      "es": "El cielo está lleno de estrellas.",
      "he": "השמיים מלאים בכוכבים."
    },
    {
      "id": "s000378",
      "es": "Nadamos en el lago todo el verano.",
      "he": "שחינו באגם כל הקיץ."
    },
    {
      "id": "s000379",
      "es": "Las flores del jardín son muy bonitas.",
      "he": "הפרחים בגינה מאוד יפים."
    },
    {
      "id": "s000380",
      "es": "El desierto es muy caliente durante el día.",
      "he": "המדבר מאוד חם במהלך היום."
    },
    {
      "id": "s000381",
      "es": "Subimos a la montaña más alta de la zona.",
      "he": "טיפסנו על ההר הגבוה ביותר באזור."
    },
    {
      "id": "s000382",
      "es": "Los niños construyen castillos de arena.",
      "he": "הילדים בונים ארמונות חול."
    }
  ]
