  "sentences": [
    {
      "id": "s000174",
      "es": "Estimado señor López, le escribo para confirmar la reunión.",
      "he": "לכבוד מר לופז, אני כותב כדי לאשר את הפגישה."
    },
    {
      "id": "s000175",
      "es": "Adjunto encontrará el contrato firmado.",
      "he": "מצורף בזאת החוזה החתום."
    },
    {
      "id": "s000176",
      "es": "Lamento informarle que el proyecto se retrasó.",
      "he": "אני מצטער להודיע שהפרויקט התעכב."
    },
    {
      "id": "s000177",
      "es": "Quedo a la espera de su respuesta. Atentamente.",
      "he": "אני ממתין לתשובתך. בברכה."
    },
    {
      "id": "s000178",
      "es": "En referencia a su solicitud, adjunto el informe.",
      "he": "בהתייחס לבקשתך, מצורף הדוח."
    },
    {
      "id": "s000179",
      "es": "Le agradezco de antemano su pronta respuesta.",
      "he": "תודה מראש על תשובתך המהירה."
    },
    {
      "id": "s000180",
      "es": "Rogamos disculpe las molestias que esto pueda causar.",
      "he": "אנא סלח על אי הנוחות שזה עלול לגרום."
    },
    {
      "id": "s000181",
      "es": "Le informo que el pedido llegará la próxima semana.",
      "he": "אני מודיע לך שההזמנה תגיע בשבוע הבא."
    }
  ]
