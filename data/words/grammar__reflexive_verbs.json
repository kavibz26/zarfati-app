  "sentences": [
    {
      "id": "s000447",
      "es": "¿A qué hora te despiertas los fines de semana?",
      "he": "באיזו שעה אתה מתעורר בסופי שבוע?"
    },
    {
      "id": "s000448",
      "es": "Ella se viste elegante para la fiesta.",
      "he": "היא מתלבשת בהידור למסיבה."
    },
    {
      "id": "s000449",
      "es": "Nos reímos mucho durante la película.",
      "he": "צחקנו הרבה במהלך הסרט."
    },
    {
      "id": "s000450",
      "es": "Mi hermano se relaja escuchando música.",
      "he": "אחי נרגע כשהוא מקשיב למוזיקה."
    },
    {
      "id": "s000451",
      "es": "No te preocupes, todo va a salir bien.",
      "he": "אל תדאג, הכל יסתדר."
